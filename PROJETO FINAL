 <style>

  :root {

   --azul: #3b82f6;

   --azul-neon: #22d3ee;

   --preto: #05060a;

   --cinza: #0e1018;

   --borda: #1c2033;

  }

  html { scroll-behavior: smooth; scroll-padding-top: 70px; }

  body { font-family: 'Poppins', sans-serif; background: var(--preto); color: #c8cde0; }

  section { padding: 80px 0; }

  h1, h2, h3, h4, h5 { color: #fff; font-weight: 600; }



  .navbar { background: rgba(5, 6, 10, 0.92); border-bottom: 1px solid var(--borda); }

  .navbar .nav-link { color: #aab0c8; }

  .navbar .nav-link:hover { color: var(--azul-neon); }

  .navbar-brand { font-weight: 700; }

  .navbar-brand span, .destaque { color: var(--azul-neon); }



  #inicio {

   padding-top: 150px;

   padding-bottom: 110px;

   background: radial-gradient(circle at 80% 20%, rgba(59,130,246,.35), transparent 45%), var(--preto);

  }

  .selo { display: inline-block; border: 1px solid var(--azul); color: var(--azul-neon); border-radius: 30px; padding: 4px 16px; font-size: .9rem; }

  .btn-azul { background: var(--azul); color: #fff; border: 0; font-weight: 500; border-radius: 10px; padding: 10px 24px; transition: .2s; }

  .btn-azul:hover { background: var(--azul-neon); color: var(--preto); box-shadow: 0 0 20px rgba(34,211,238,.5); }

  .btn-borda { border: 1px solid var(--azul); color: #fff; border-radius: 10px; padding: 10px 24px; transition: .2s; }

  .btn-borda:hover { background: var(--azul); color: #fff; }



  .linha { width: 60px; height: 4px; background: linear-gradient(90deg, var(--azul), var(--azul-neon)); border-radius: 2px; margin: 10px auto 40px; }



  .bloco { background: var(--cinza); border: 1px solid var(--borda); border-radius: 14px; padding: 28px; }

  .bloco i { color: var(--azul-neon); }



  .habilidade { background: var(--cinza); border: 1px solid var(--borda); border-radius: 14px; padding: 24px 10px; text-align: center; transition: .25s; }

  .habilidade i { font-size: 2rem; color: var(--azul-neon); }

  .habilidade p { margin: 8px 0 0; color: #fff; font-weight: 500; }

  .habilidade:hover { border-color: var(--azul-neon); box-shadow: 0 0 18px rgba(34,211,238,.25); transform: translateY(-4px); }



  .card-projeto { background: var(--cinza); border: 1px solid var(--borda); border-radius: 14px; transition: .25s; }

  .card-projeto:hover { border-color: var(--azul); box-shadow: 0 0 22px rgba(59,130,246,.35); transform: translateY(-6px); }

  .card-projeto .icone { font-size: 2.2rem; color: var(--azul-neon); }

  .card-projeto .card-text { color: #aab0c8; }



  .tech { background: rgba(59,130,246,.15); color: var(--azul-neon); border: 1px solid rgba(59,130,246,.4); font-weight: 500; }



  .modal-content { background: var(--cinza); border: 1px solid var(--azul); color: #c8cde0; border-radius: 14px; }

  .modal-header, .modal-footer { border-color: var(--borda); }

  .btn-close { filter: invert(1); }

  .modal-body h6 { color: var(--azul-neon); margin-top: 16px; }



  #contato { background: var(--cinza); }

  .form-control { background: var(--preto); border: 1px solid var(--borda); color: #fff; border-radius: 10px; padding: 12px; }

  .form-control::placeholder { color: #6b7190; }

  .form-control:focus { background: var(--preto); color: #fff; border-color: var(--azul); box-shadow: 0 0 0 .2rem rgba(59,130,246,.25); }

  .form-label { color: #fff; }



  footer { border-top: 1px solid var(--borda); }

 </style>

</head>

